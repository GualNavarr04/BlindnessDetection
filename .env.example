# Copia este archivo a .env y pon tus valores reales. .env no se sube a git.

AWS_REGION=us-east-1
S3_BUCKET_MODELS=blindness-detection-modelos-<account-id>
S3_BUCKET_PREDICTIONS=blindness-detection-predicciones-<account-id>

# Rol que usan los trabajos de entrenamiento de SageMaker AI.
SAGEMAKER_ROLE_ARN=arn:aws:iam::<account-id>:role/BlindnessDetection-SageMakerRole

# CloudWatch para la API en EC2. El rol de EC2 solo permite grupos /blindness-detection/*
# y el namespace BlindnessDetection.
CLOUDWATCH_LOG_GROUP=/blindness-detection/api
CLOUDWATCH_NAMESPACE=BlindnessDetection

# Carpeta donde vive access_token (o kaggle.json) para la API de Kaggle (uso en local).
KAGGLE_CONFIG_DIR=~/.kaggle

# Parámetro de Parameter Store con el token de Kaggle (lo usan los entrenamientos de SageMaker).
KAGGLE_TOKEN_PARAM=/blindness-detection/kaggle-token

# Carpeta para el dataset. En SageMaker Studio va en el disco del espacio.
# (Si trabajas en tu computadora, ponla FUERA de OneDrive para no sincronizar GB de imágenes.)
DATA_DIR=/home/sagemaker-user/data/aptos
